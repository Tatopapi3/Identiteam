# Copy this file to .env and fill in your key.
# The server reads this — never exposed to the browser.
ANTHROPIC_API_KEY=

# Optional — defaults to 8787
PORT=8787

# Cloned past-self voice (Comfy Cloud Chatterbox). Optional; falls back to the browser voice.
# Key from https://platform.comfy.org/profile/api-keys
COMFY_CLOUD_API_KEY=
# "on" = the 5 demo questions answer instantly with Erasmo's own pre-recorded
# clips in public/audio/, regardless of what's actually in the capsule being
# used. That's intentional for his specific demo walkthrough, but wrong for
# anyone else's real capsule -- leave this off (or unset) for normal use, so
# every answer comes from the live, grounded AI response instead.
VOICE_CLIPS=off
