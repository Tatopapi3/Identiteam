# Copy this file to .env and fill in your key.
# The server reads this — never exposed to the browser.
ANTHROPIC_API_KEY=

# Optional — defaults to 8787
PORT=8787

# Cloned past-self voice (Comfy Cloud Chatterbox). Optional; falls back to the browser voice.
# Key from https://platform.comfy.org/profile/api-keys
COMFY_CLOUD_API_KEY=
# "on" = demo questions answer instantly with the pre-recorded clips in public/audio/
VOICE_CLIPS=on
